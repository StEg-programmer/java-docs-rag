# Reference values only. The scaffold does not load .env automatically.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=java_docs
# Only for Qdrant Cloud / secured instances.
QDRANT_API_KEY=
# Developer B indexing defaults (see configs/models.yaml).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
# Optional: where Hugging Face caches model weights (outside the repository).
HF_HOME=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Observability is disabled; no credentials are required for scaffold tests.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
